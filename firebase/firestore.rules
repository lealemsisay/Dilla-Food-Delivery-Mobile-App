rules_version = '2';
// Starter rules: least privilege. Role/approval fields are written only by Cloud Functions (admin SDK).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'customer';
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
    }
    match /restaurants/{rid} {
      allow read: if signedIn() && resource.data.approvalStatus == 'approved';
      allow write: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      match /menuItems/{iid} { allow read: if signedIn(); allow write: if isAdmin() || get(/databases/$(db)/documents/restaurants/$(rid)).data.ownerUid == request.auth.uid; }
    }
    // Orders, payments, deliveries, groupOrders: created/updated by Cloud Functions only.
    match /orders/{oid} {
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || resource.data.riderUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /payments/{pid} { allow read: if signedIn() && resource.data.payerUid == request.auth.uid; allow write: if false; }
    match /auditLogs/{lid} { allow read: if isAdmin(); allow write: if false; }
  }
}
